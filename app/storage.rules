rules_version = '2';

// TEMPORARY dev/testing rule — same reasoning as firestore.rules. Any
// signed-in user has full access; real per-role rules come with the User &
// Permission module. Unauthenticated access stays blocked.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
